            tensor<fp16, [1, 12, 192, 192]> x2_cast_fp16 = conv(bias = conv_last_bias_to_fp16, dilations = x2_dilations_0, groups = x2_groups_0, pad = x2_pad_0, pad_type = x2_pad_type_0, strides = x2_strides_0, weight = conv_last_weight_to_fp16, x = input_49_cast_fp16)[name = string("x2_cast_fp16")];
